{
  "name": "mobinogi-crawler",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "main": "dist/app.js",
  "scripts": {
    "node": "tsx watch src/app.ts",
    "lint": "eslint",
    "build": "npx tsc --project tsconfig.json",
    "build2": "esbuild src/app.ts --bundle --platform=node --target=node24 --outfile=dist/app.js --format=cjs",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@mobinogi/shared": "*",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "got": "^14.6.6",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.11",
    "puppeteer": "^24.36.0",
    "redis": "^5.10.0",
    "tough-cookie": "^6.0.0",
    "vercel": "^50.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "esbuild": "0.27.3",
    "eslint": "^9",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}