    "vercel": "npx vercel dev --listen 8000"
  },
  "dependencies": {
    "@mobinogi/shared": "*",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.11",
    "puppeteer": "^24.36.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^5.10.0",
    "vercel": "^50.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "esbuild": "0.27.3",
    "eslint": "^9",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}