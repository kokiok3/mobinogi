{
  "compilerOptions": {
    "target": "ES2017",
    // "module": "esnext",
    // "moduleResolution": "bundler",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist", /* 빌드 결과물 저장 위치 */
    // "rootDir": "../../",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "#src/*": [
        "./src/*"
      ],
      "@mobinogi/shared": [
        "../../packages/shared/index.ts"
      ],
      "@mobinogi/shared/*": [
        "../../packages/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}